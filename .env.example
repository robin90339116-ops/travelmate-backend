# 复制为 .env 或以环境变量方式注入。dev 默认全部留空即可用 H2 启动。

# AI Provider(阿里百炼 / 通义千问,OpenAI 兼容)
AI_PROVIDER=bailian
DASHSCOPE_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_TEXT_MODEL=qwen-plus
AI_VISION_MODEL=qwen-vl-plus

# 高德地图 Web 服务 Key(需开通「Web 服务」)
AMAP_WEB_KEY=

# JWT
JWT_SECRET=travelmate-dev-secret-change-me-please-32bytes

# 短信开发验证码
SMS_DEV_CODE=246810

# 异步模式:local(默认,线程池)| rabbit(需 mq profile + RabbitMQ)
ASYNC_MODE=local

# 生产基础设施(prod profile)
DATASOURCE_URL=jdbc:mysql://localhost:3306/travelmate?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
DATASOURCE_USER=travelmate
DATASOURCE_PASSWORD=travelmate
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
